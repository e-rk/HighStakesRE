const NOTE: int = 60
const VELOCITY: int = 0x7f
const MASTER_VOLUME: int = 0x7f
const ENVELOPE_LEVEL: int = 0x7f


static func randrange(limit: int, random: int) -> int:
	var clamped: int = clampi(limit, 0, 0x10000)
	return (((random & 0x7fff) - 0x4000) * clamped) >> 0xe


func play_detune(note: int, random: int) -> int:
	return self.detune + (self.root_key - note) * -100 + randrange(self.detune_random_range, random)


func play_volume(velocity: int, random: int) -> int:
	var timbre_volume: int = clampi(self.volume + randrange(self.volume_random_range, random), -0x80, 0x7f)
	@warning_ignore("integer_division")
	var result: int = timbre_volume * velocity / 0x7f
	return result


static func calc_volume_re(master: int, request_volume: int, timbre_volume: int, envelope: int) -> int:
	@warning_ignore("integer_division")
	var result: int = master * request_volume * timbre_volume * envelope / 0x1f417f
	return result


func detune_to_linear(val: int) -> int:
	const UNIT = 1200
	var ret: int = 4096
	while UNIT <= val:
		val -= UNIT
		ret *= 2
	while val <= -UNIT:
		val += UNIT
		ret >>= 1
	var idx: int = maxi((val * 13981) >> 0x10, -0xff)
	if -1 < idx:
		return (ret * (CENTS[idx] + 0x100)) >> 8
	return (ret * (CENTS[len(CENTS) + idx] + 0x100)) >> 9


func pitch_calculate_re(pitch_bend: int, bend_range: int, cents: int) -> int:
	var val: int = cents + ((pitch_bend - 64) * bend_range >> 6)
	var detuned: int = self.detune_to_linear(val)
	var res: int = (detuned * 4096) >> 0xc
	return res


func pitch_calculate(pitch_bend: int, cents: int) -> float:
	var linear: int = self.pitch_calculate_re(pitch_bend, self.pitch_bend_range * 100, cents)
	return linear / 4096.0


static func gas_from_throttle(throttle: float) -> int:
	var gas: int = clampi(int(throttle * 0xff), 0, 0xff) >> 1
	gas = mini(gas + (gas >> 5), 0x7f)
	if gas < 4:
		return 0
	return gas


static func front_rear_mix(forward: int, distance: int) -> int:
	if distance == 0:
		return 0x1e
	@warning_ignore("integer_division")
	var cosine: int = forward / distance
	var shift: int = 11 if cosine < 0 else 10
	var mix: int = ((cosine >> shift) + 0x2c) & 0xff
	return mini(mix, 0x7f)


func volume_calculate_re(volume_value: int, is_load: bool, is_rear: bool, gas: int, mix: int) -> int:
	var gas_idx: int = gas if is_load else 0x7f - gas
	var scaled: int = (LOG_TABLE[gas_idx] * volume_value) >> 7
	var mix_idx: int = (0x7f - mix) >> 1 if is_rear else mix
	return (LOG_TABLE[mix_idx] * scaled) >> 7


func volume_calculate(volume_value: int, is_load: bool, gas: int, mix: int, timbre_volume: int) -> float:
	var request_volume: int = self.volume_calculate_re(volume_value, is_load, self.rear, gas, mix)
	var result: int = calc_volume_re(MASTER_VOLUME, request_volume, timbre_volume, ENVELOPE_LEVEL)
	return linear_to_db(maxi(result, 0) / 127.0)


func get_volume_for_idx(idx: int, gas: int, mix: int, timbre_volume: int) -> float:
	return self.volume_calculate(self.table.volume[idx], self.table.is_load, gas, mix, timbre_volume)


func get_pitch_for_idx(idx: int, cents: int) -> float:
	return self.pitch_calculate(self.table.pitch[idx], cents)
